# Copy to .env for local development; Bun loads it automatically.
# Every variable without a default is required: the server refuses to start
# and lists everything missing. See src/config.ts and docs/DEPLOYMENT.md §3.

# Optional: HTTP listen port. Default: 3000.
# PORT=3000

# Postgres connection string for the auth database (docs/DESIGN.md §8).
DATABASE_URL=postgres://auth:auth@localhost:5432/auth

# The issuer: auth's own origin, https (http only on a loopback host), no path.
ISSUER_URL=http://localhost:3000

# The deployment's services file (docs/DESIGN.md §6).
SERVICES_FILE=./services.json

# 32 random bytes, base64: openssl rand -base64 32. Encrypts signing keys and
# TOTP secrets at rest; keep a copy offline with the backups.
AUTH_ENCRYPTION_KEY=

# The prefix of API keys, for a secret scanner. Required when a service
# declares api_key_scopes.
# API_KEY_PREFIX=example

# Optional: proxies whose X-Real-IP is trusted, as IPs or CIDR ranges,
# comma-separated. Default: none, so every client is its connecting address.
# TRUSTED_PROXIES=10.0.0.0/8

# Where auth sends email: smtps://user:password@host[:465], or smtp:// with
# STARTTLS; plain smtp:// only to a loopback host, such as a local mail catcher.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Auth <auth@example.com>

# Optional: days of audit log kept. Default: 365.
# AUDIT_RETENTION_DAYS=365

# Optional: whether people may delete their own accounts. Default: false.
# ALLOW_ACCOUNT_DELETION=false

# Optional: an http(s) webhook that receives {"text": "..."} alerts.
# ALERT_WEBHOOK_URL=

# Optional, tests only: a Postgres the database tests may connect to. Each
# test file creates a schema of its own and drops it, so the database above
# is fine.
# TEST_DATABASE_URL=postgres://auth:auth@localhost:5432/auth
